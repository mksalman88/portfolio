<div class="col mb-4">
  <a href="{% if project.redirect %}{{ project.redirect }}{% else %}{{ project.url | relative_url }}{% endif %}">
    <div class="card h-100 hoverable">
      <div class="row no-gutters">
        {% if project.img %}
          <div class="col-md-3" style="overflow: hidden; max-height: 150px;">
            {% include figure.liquid loading="eager" path=project.img sizes="(min-width: 768px) 156px, 50vw" alt="project thumbnail" class="card-img" style="object-fit: cover; height: 150px; width: 100%;" %}
          </div>
        {% endif %}
        <div class="{% if project.img %}col-md-9{% else %}col-md-12{% endif %}">
          <div class="card-body py-2 px-3">
            <h5 class="card-title mb-1">{{ project.title }}</h5>
            {% if project.description %}
              <p class="card-text" style="font-size: 0.85rem;">{{ project.description }}</p>
            {% endif %}
          </div>
        </div>
      </div>
    </div>
  </a>
</div>
